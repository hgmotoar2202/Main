# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
PORT=3001
MONGODB_URI=mongodb://localhost:27017/insure_ai
# Proveedor de IA: simulated (por defecto, sin clave) o anthropic (opcional)
AI_PROVIDER=simulated
ANTHROPIC_API_KEY=
JWT_SECRET=cambia-esto-solo-para-desarrollo
STORAGE_DIR=./storage